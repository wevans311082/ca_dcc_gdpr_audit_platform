# Copy this file to .env for local RAG development. Do not commit production secrets.
POSTGRES_DB=audit_platform
POSTGRES_USER=audit_platform
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql://audit_platform:change-me-before-production@postgres:5432/audit_platform

REDIS_URL=redis://redis:6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-before-production
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=audit-documents
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4.1-mini
RAG_RESULT_LIMIT=5
RAG_MINIMUM_SCORE=0.35
JWT_SECRET=replace-with-a-long-random-secret
API_PORT=3000
UPLOAD_MAX_BYTES=52428800
